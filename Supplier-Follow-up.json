    {
      "parameters": {
        "jsCode": "// Expects due_date as YYYY-MM-DD (recommended) or DD/MM/YYYY.\nconst today = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'America/Argentina/Buenos_Aires',\n  year: 'numeric', month: '2-digit', day: '2-digit'\n}).format(new Date());\n\nfunction normalizeDate(value) {\n  const s = String(value ?? '').trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return s;\n  const dmy = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (dmy) return `${dmy[3]}-${dmy[2].padStart(2,'0')}-${dmy[1].padStart(2,'0')}`;\n  return '';\n}\n\nreturn $input.all().map(item => {\n  const row = item.json;\n  const status = String(row.document_status ?? '').trim().toLowerCase();\n  const dueDate = normalizeDate(row.due_date);\n  let followUpStatus;\n  if (status === 'received') followUpStatus = 'RECEIVED';\n  else if (status === 'pending' && dueDate && dueDate < today) followUpStatus = 'OVERDUE';\n  else if (status === 'pending' && dueDate) followUpStatus = 'PENDING_ON_TIME';\n  else followUpStatus = 'REVIEW_REQUIRED';\n  return { json: { ...row, due_date: dueDate || row.due_date, follow_up_status: followUpStatus, evaluation_date: today, email_status: String(row.email_status ?? '').trim(), approval_status: String(row.approval_status ?? '').trim() } };\n});"
      },
